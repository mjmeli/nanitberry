# Use a persistent path on your NAS share, accessible by Docker/Portainer.
DATA_DIR=/path/to/nas/share/nanit-huckleberry-sync
TZ=America/New_York
NANIT_EMAIL=
NANIT_PASSWORD=
NANIT_BABY_UID=
HUCKLEBERRY_EMAIL=
HUCKLEBERRY_PASSWORD=
HUCKLEBERRY_CHILD_UID=
RUN_AT=11:00
HEALTH_MAX_AGE_HOURS=36
BACKFILL_DAYS=7
NIGHT_START=18:00
MORNING_CUTOFF=10:00
USE_HUCKLEBERRY_HOURS=false
MAX_NIGHT_WAKE_MINUTES=20
SYNC_DAYTIME=false
MAX_DAY_WAKE_MINUTES=0
WRITE_ENABLED=false

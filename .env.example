# Copy to .env and fill in your account details. Keep this file private.
TZ=America/New_York
NANIT_EMAIL=
NANIT_PASSWORD=
HUCKLEBERRY_EMAIL=
HUCKLEBERRY_PASSWORD=
# Leave blank if each account has one child; otherwise map Nanit UID to Huckleberry UID.
CHILD_UID_MAP=
HEALTH_MAX_AGE_HOURS=36
BACKFILL_DAYS=7
USE_HUCKLEBERRY_HOURS=true
# NIGHT_START and MORNING_CUTOFF are used only when USE_HUCKLEBERRY_HOURS=false.
# NIGHT_START=18:00
# MORNING_CUTOFF=10:00
MAX_WAKE_MINUTES=20
SYNC_DAYTIME=false
WRITE_ENABLED=false
STATE_DIR=/data
